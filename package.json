{
    "private": true,
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "development": "vite --host 0.0.0.0",
        "watch": "vite --host 0.0.0.0",
        "hot": "vite --host 0.0.0.0",
        "prod": "npm run production",
        "production": "vite build",
        "test:frontend": "vitest run",
        "test:php": "docker compose -f docker-compose-dev.yml run --rm --no-deps --entrypoint sh webserver -lc \"cd /var/www/html && ./vendor/bin/phpunit\"",
        "check:deps": "node scripts/check-deps.js",
        "check:legacy": "node scripts/check-legacy.js",
        "check:legacy:hard": "sh scripts/check-legacy-hard.sh",
        "audit:migration:review": "sh scripts/audit-migration-review.sh",
        "check:css": "node scripts/check-css-legacy.js && node scripts/check-dark-theme-contrast.js",
        "check:dark-theme": "node scripts/check-dark-theme-contrast.js",
        "check:migration": "npm run check:deps && npm run check:legacy:hard && npm run production"
    },
    "devDependencies": {
        "@vue/test-utils": "^2.4.11",
        "axios": "^1.16.1",
        "deepmerge": "^4.2.2",
        "jsdom": "^29.1.1",
        "laravel-echo": "1.16.1",
        "laravel-vite-plugin": "^2.1.0",
        "lodash": "^4.17.19",
        "moment": "^2.30.1",
        "postcss": "^8.1.14",
        "pusher-js": "^8.4.0-rc2",
        "sass": "^1.55.0",
        "vite": "^7.3.3",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/compiler-sfc": "^3.5.34",
        "vue": "^3.5.34",
        "vue-router": "^4.6.4",
        "vuetify": "^3.12.6",
        "vuex": "^4.1.0"
    }
}
